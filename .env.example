# Settings for Python run directly on the host.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=warehouse
POSTGRES_USER=warehouse
POSTGRES_PASSWORD=

# Port Compose publishes on the host. PostgreSQL listens on 5432 inside Docker.
POSTGRES_HOST_PORT=5433

API_BASE_URL=https://data.cityofchicago.org
SOCRATA_APP_TOKEN=
QUALITY_MAX_FAILURE_RATE=0.05
API_INCREMENTAL_TIMEOUT_SECONDS=120
